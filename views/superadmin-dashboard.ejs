<%- include('partials/header') %><section class="page"><span class="eyebrow">PLATFORM OVERVIEW</span><h1>Superadmin dashboard</h1><h2>All users</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Verified</th></tr></thead><tbody><% for (const person of users) { %><tr><td><%= person.id %></td><td><%= person.name %></td><td><%= person.email %></td><td><%= person.role %></td><td><%= person.is_verified?'Yes':'No' %></td></tr><% } %></tbody></table></div><h2>All listings</h2><div class="table-wrap"><table><thead><tr><th>Home</th><th>Landlord</th><th>Status</th><th>Action</th></tr></thead><tbody><% for (const listing of listings) { %><tr><td><% if (listing.is_active) { %><a href="/listings/<%= listing.id %>"><%= listing.title %></a><% } else { %><%= listing.title %><% } %></td><td><%= listing.landlord_name %></td><td><%= listing.is_active?'Active':'Deactivated' %></td><td><% if (listing.is_active) { %><form action="/superadmin/listings/<%= listing.id %>/deactivate" method="POST" data-confirm="Deactivate this listing? It will disappear from tenant and landlord pages."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="outline small" type="submit">Deactivate</button></form><% } else { %>—<% } %></td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>
