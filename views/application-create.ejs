<%- include('partials/header') %><section class="form-panel"><a class="back" href="/listings/<%= listing.id %>">← Back to home</a><span class="eyebrow">YOUR NEXT CHAPTER</span><h1>Apply for this home</h1><p><%= listing.title %> · <%= listing.location %></p><p class="muted">Apply by <%= formatDate(listing.deadline) %> BTT</p>
<form action="/listings/<%= listing.id %>/apply" method="POST" enctype="multipart/form-data" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="full_name">Full name</label><input id="full_name" name="full_name" value="<%= user.name %>" maxlength="100" autocomplete="name" required><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" maxlength="30" placeholder="+975 17 123 456" autocomplete="tel" required><label for="notes">Notes <span class="muted">(optional)</span></label><textarea id="notes" name="notes" rows="4" maxlength="2000" placeholder="Anything you would like the landlord to know."></textarea><label for="documents">Supporting documents <span class="muted">(optional)</span></label><input id="documents" name="documents" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" multiple><small>Up to 3 files, 5 MB each. PDF, JPG, PNG or WebP. Only you and this landlord can download them.</small><button type="submit">Submit application</button></form></section><%- include('partials/footer') %>
