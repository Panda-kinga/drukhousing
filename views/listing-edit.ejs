<%- include('partials/header') %><section class="form-panel"><a class="back" href="/landlord/dashboard">← My listings</a><span class="eyebrow">UPDATE YOUR HOME</span><h1>Edit your home</h1>
<form action="/landlord/listings/<%= listing.id %>" method="POST" class="stack" data-location-form data-dzongkhag-value="<%= listing.dzongkhag || '' %>" data-gewog-value="<%= listing.gewog || '' %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label for="title">Listing title</label><input id="title" name="title" maxlength="150" value="<%= listing.title %>" required>
<div class="form-grid"><div><label for="dzongkhag">Dzongkhag</label><select id="dzongkhag" name="dzongkhag" data-dzongkhag required><option value="">Choose Dzongkhag</option></select></div><div><label for="gewog">Gewog</label><select id="gewog" name="gewog" data-gewog disabled required><option value="">Choose Gewog</option></select></div><p data-location-error class="muted"></p></div>
<label for="location">Home name or street</label><input id="location" name="location" maxlength="150" value="<%= listing.location %>" required>
<div class="form-grid"><div><label for="price">Monthly rent (Nu.)</label><input id="price" name="price" type="number" min="0.01" max="9999999999.99" step="0.01" value="<%= listing.price %>" required></div><div><label for="type">Home type</label><select id="type" name="type" required><% for (const item of ['apartment','house','room']) { %><option value="<%= item %>" <%= listing.type===item?'selected':'' %>><%= item.charAt(0).toUpperCase()+item.slice(1) %></option><% } %></select></div></div>
<div class="form-grid"><div><label for="lease_years">Lease duration (years)</label><input id="lease_years" name="lease_years" type="number" min="1" max="100" step="1" value="<%= listing.lease_years %>" required></div><div><label for="deadline">Application deadline (Bhutan time)</label><input id="deadline" name="deadline" type="datetime-local" value="<%= new Date(listing.deadline).toISOString().slice(0,16) %>" required></div></div>
<button type="submit">Save changes</button></form></section><%- include('partials/footer') %>
