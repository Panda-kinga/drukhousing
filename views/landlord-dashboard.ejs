<%- include('partials/header') %><section class="page"><div class="section-heading"><div><span class="eyebrow">WELCOME, <%= user.name %></span><h1>My listings</h1><p class="muted">Your homes. Their next beginning.</p></div><a class="button" href="/landlord/listings/new">+ List a home</a></div>
<% if (!listings.length) { %><div class="empty"><h3>Your first listing starts here.</h3><p>Add your home, a few photos and an application deadline.</p><a class="button" href="/landlord/listings/new">Create listing</a></div><% } %>
<div class="row-list"><% for (const listing of listings) { %><article class="application-row"><div><h3><a href="/listings/<%= listing.id %>"><%= listing.title %></a></h3><p><%= listing.location %> · Nu. <%= money(listing.price) %> / month</p><small>Deadline: <%= formatDate(listing.deadline) %> BTT</small></div><div class="row-end"><span class="badge neutral"><%= listing.application_count %> applications</span><a class="button outline small" href="/landlord/listings/<%= listing.id %>/applications">View applications</a></div></article><% } %></div></section><%- include('partials/footer') %>
