<%- include('partials/header') %><section class="page"><span class="eyebrow">ADMINISTRATION</span><h1>Properties</h1><%- include('partials/superadmin-nav') %><div class="table-wrap"><table><thead><tr><th>Property</th><th>Landlord</th><th>Status</th><th>Action</th></tr></thead><tbody><% for (const listing of listings) { %><tr><td><%= listing.title %></td><td><%= listing.landlord_name %></td><td><span class="status-pill <%= listing.is_active?'status-active':'status-removed' %>"><%= listing.is_active?'Active':'Removed' %></span></td><td class="admin-actions-cell"><form method="POST" action="/superadmin/listings/<%= listing.id %>/<%= listing.is_active?'deactivate':'restore' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small <%= listing.is_active?'outline':'' %>" type="submit"><%= listing.is_active?'Remove':'Restore' %></button></form></td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>
