<%- include('partials/header') %><section class="page"><span class="eyebrow">YOUR EXPERIENCE MATTERS</span><h1>My feedback</h1><% if (eligible.length) { %><form action="/tenant/feedback" method="POST" class="stack feedback-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><div><label for="listing_id">Home</label><select id="listing_id" name="listing_id" required><option value="">Choose a home</option><% for (const listing of eligible) { %><option value="<%= listing.id %>"><%= listing.title %></option><% } %></select></div><div><label for="rating">Rating</label><select id="rating" name="rating" required><option value="">Choose a rating</option><% for (let n=5;n>=1;n--) { %><option value="<%= n %>"><%= n %> out of 5</option><% } %></select></div></div><label for="comment">Comment <span class="muted">(optional)</span></label><textarea id="comment" name="comment" rows="3" maxlength="2000" placeholder="Share your experience."></textarea><button type="submit">Submit feedback</button></form><% } else { %><p class="notice">You can leave feedback once per home after your application is accepted.</p><% } %><h2>Feedback you have left</h2><%- include('partials/feedback-list') %></section><%- include('partials/footer') %>
