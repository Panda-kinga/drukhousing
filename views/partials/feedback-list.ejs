<% if (!feedback.length) { %><div class="empty"><h3>No feedback yet</h3><p>Feedback will appear here once an accepted tenant shares it.</p></div><% } %>
<div class="feedback-grid"><% for (const item of feedback) { %><article class="feedback-card"><div class="stars" aria-label="<%= item.rating %> out of 5 stars"><%= '★'.repeat(item.rating) %><span><%= '☆'.repeat(5-item.rating) %></span></div><h3><a href="/listings/<%= item.listingId %>"><%= item.title %></a></h3><% if (item.comment) { %><p class="user-text"><%= item.comment %></p><% } %><small><%= item.tenantName %> · <%= formatDate(item.createdAt) %> BTT</small></article><% } %></div>
