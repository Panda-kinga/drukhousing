<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Find a place to call home in Bhutan. Browse rentals and apply with <%= siteName %>." />
  <title><%= title %> · <%= siteName %></title>
  <link rel="icon" href="/images/mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="roofline" aria-hidden="true"></div>
<header class="site-header">
  <a class="brand" href="/"><img src="/images/mark.svg" alt="" width="38" height="38"><%= siteName %></a>
  <nav aria-label="Main navigation">
    <a href="/">Find a home</a>
    <% if (user) { %>
      <% if (user.role === 'tenant') { %>
        <a href="/tenant/dashboard">Dashboard</a><a href="/tenant/applications">My applications</a><a href="/tenant/feedback">My feedback</a>
      <% } else if (user.role === 'landlord') { %>
        <a href="/landlord/dashboard">My listings</a><a href="/landlord/feedback">Customer feedback</a>
      <% } else { %><a href="/superadmin/dashboard">Superadmin</a><% } %>
      <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Log out</button></form>
    <% } else { %>
      <a href="/login">Log in</a><a class="button small" href="/signup">Get started</a>
    <% } %>
  </nav>
</header>
<main id="main">
