<% if (!applications.length) { %><div class="empty"><h3>No applications yet</h3><p>Find a home you like and send your first application.</p><a class="button" href="/#homes">Browse homes</a></div><% } %>
<div class="row-list"><% for (const application of applications) { %><article class="application-row"><div><h3><a href="/listings/<%= application.listing_id %>"><%= application.title %></a></h3><p class="muted"><%= application.location %></p><small>Applied <%= formatDate(application.created_at) %> BTT</small></div><span class="badge <%= application.status %>"><%= application.status %></span></article><% } %></div>
