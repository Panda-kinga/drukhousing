<%- include('partials/header') %>
<section class="auth-layout"><div class="auth-picture"><img src="/images/bhutan-home.png" alt="Traditional Bhutanese house"><div><span class="eyebrow">KUZUZANGPO</span><h2>A new home.<br>A new beginning.</h2></div></div><div class="auth-panel"><span class="eyebrow">WELCOME TO <%= siteName.toUpperCase() %></span><h1>Create an account</h1><p class="muted">A few details, and you are ready.</p>
<form action="/signup" method="POST" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label for="name">Full name</label><input id="name" name="name" maxlength="100" autocomplete="name" required>
<label for="email">Email address</label><input id="email" name="email" type="email" maxlength="254" autocomplete="email" required>
<label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required><button type="button" class="password-toggle" data-password-toggle aria-controls="password" aria-label="Show password">Show</button></div><small>At least 8 characters.</small>
<fieldset><legend>I am a</legend><div class="role-options"><label><input type="radio" name="role" value="tenant" required> Tenant</label><label><input type="radio" name="role" value="landlord" required> Landlord</label></div></fieldset>
<button type="submit">Create account</button></form><p class="form-bottom">Already registered? <a href="/login">Log in</a></p></div></section>
<%- include('partials/footer') %>
