<%- include('partials/header') %><section class="page"><span class="eyebrow">ADMINISTRATION</span><h1>Feedback</h1><%- include('partials/superadmin-nav') %><div class="table-wrap"><table><thead><tr><th>Rating</th><th>Comment</th><th>Tenant</th><th>Action</th></tr></thead><tbody><% for (const item of feedback) { %><tr><td><span class="status-pill status-active"><%= item.rating %> / 5</span></td><td><%= item.comment || '—' %></td><td><%= item.tenantName %></td><td class="admin-actions-cell"><form method="POST" action="/superadmin/feedback/<%= item._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small outline" type="submit">Delete</button></form></td></tr><% } %></tbody></table></div></section><%- include('partials/footer') %>
