<%- include('partials/header') %><section class="page"><span class="eyebrow">ADMINISTRATION</span><h1>Users</h1><%- include('partials/superadmin-nav') %>
<form method="GET" action="/superadmin/users" class="admin-filter-form"><input name="search" value="<%= filters.search %>" placeholder="Search name or email"><select name="role"><option value="">All roles</option><% for (const role of ['tenant','landlord','superadmin']) { %><option value="<%= role %>" <%= filters.role===role?'selected':'' %>><%= role %></option><% } %></select><select name="verified"><option value="">All verification states</option><option value="true" <%= filters.verified==='true'?'selected':'' %>>Verified</option><option value="false" <%= filters.verified==='false'?'selected':'' %>>Unverified</option></select><button type="submit">Filter users</button></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody><% for (const person of people) { %><tr><td><%= person.name %></td><td><%= person.email %></td><td><%= person.role %></td><td><%= person.is_active?'Active':'Inactive' %> · <%= person.is_verified?'Verified':'Unverified' %></td><td class="admin-actions-cell"><% if (person.role !== 'superadmin') { %><div class="admin-actions"><form method="POST" action="/superadmin/users/<%= person.id %>/role"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="<%= person.role==='tenant'?'landlord':'tenant' %>"><button class="small" type="submit">Make <%= person.role==='tenant'?'landlord':'tenant' %></button></form><form method="POST" action="/superadmin/users/<%= person.id %>/active"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= person.is_active?'false':'true' %>"><button class="small outline" type="submit"><%= person.is_active?'Deactivate':'Reactivate' %></button></form><% if (!person.is_verified) { %><form method="POST" action="/superadmin/users/<%= person.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="small outline" type="submit">Verify</button></form><% } %></div><% } else { %><span class="muted">Protected</span><% } %></td></tr><% } %></tbody></table></div>
<div class="admin-pagination"><span>Page <%= filters.page %> of <%= pageCount %></span><div class="admin-actions"><% if (filters.page > 1) { %><a class="button small outline" href="/superadmin/users?page=<%= filters.page-1 %>&search=<%= encodeURIComponent(filters.search) %>&role=<%= encodeURIComponent(filters.role) %>&verified=<%= encodeURIComponent(filters.verified) %>">Previous</a><% } %><% if (filters.page < pageCount) { %><a class="button small outline" href="/superadmin/users?page=<%= filters.page+1 %>&search=<%= encodeURIComponent(filters.search) %>&role=<%= encodeURIComponent(filters.role) %>&verified=<%= encodeURIComponent(filters.verified) %>">Next</a><% } %></div></div></section><%- include('partials/footer') %>
